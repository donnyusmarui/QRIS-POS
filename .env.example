# Neon DB (PostgreSQL Serverless)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# SQLite Fallback / Turso (Optional)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# JWT Secrets for Authentication
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters
JWT_REFRESH_SECRET=your-secure-refresh-jwt-secret-32-characters

# Application Configuration
VITE_APP_NAME=QRIS-POS
NETLIFY_SITE_ID=

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false
PAYMENT_WEBHOOK_SECRET=whsec_qris_pos_internal_v1
